---
---
{% comment %} One CV publication, read from papers.bib (see the Publications branch in _layouts/cv.liquid). {% endcomment %}
{% assign paper_note = site.data.homepage.papers.notes | where_exp: 'note', 'note.eprint == entry.eprint' | first %}
<article class="cv-paper">
  <span class="cv-paper-year">{{ entry.year }}</span>
  <div>
    <a class="cv-paper-title" href="{% if entry.adsurl %}{{ entry.adsurl }}{% elsif entry.doi %}https://doi.org/{{ entry.doi }}{% endif %}">
      {{- entry.title | replace: 'H_0', 'H₀' | replace: '  300', ' ~300' -}}
    </a>
    <p class="cv-paper-authors">
      {% for author in entry.author_array limit: 3 -%}
        {%- if author.last == 'Zhang' and author.first contains 'Zijian' -%}
          <strong>{{ author.first }} {{ author.last }}</strong>
        {%- else -%}
          {{ author.first }}
          {{ author.last }}
        {%- endif -%}
        {%- unless forloop.last %}, {% endunless -%}
      {%- endfor -%}
      {%- if entry.author_array.size > 3 %}, et al.{% endif %}
      {%- if paper_note.role %} ({{ paper_note.role | downcase }}){% endif %}
    </p>
    <p class="cv-paper-venue">
      {{- entry.journal -}}
      {%- if entry.volume %}, {{ entry.volume }}{% endif -%}
      {%- if paper_note.status %} · {{ paper_note.status }}{% endif -%}
    </p>
  </div>
</article>
