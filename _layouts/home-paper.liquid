---
---
{% comment %} where_exp, not where: the cached `where` filter misses entries inside jekyll-scholar templates. {% endcomment %}
{% assign paper_note = site.data.homepage.papers.notes | where_exp: 'note', 'note.eprint == entry.eprint' | first %}
<article class="home-paper">
  <span class="paper-year">{{ entry.year }}</span>
  <div>
    <h4>
      <a href="{% if entry.adsurl %}{{ entry.adsurl }}{% else %}{{ '/publications/' | relative_url }}{% endif %}">
        {{- entry.title | replace: 'H_0', 'H₀' | replace: '  300', ' ~300' -}}
      </a>
    </h4>
    <p>
      {% for author in entry.author_array limit: 3 -%}
        {%- if author.last == 'Zhang' and author.first contains 'Zijian' -%}
          <strong>
            {{- author.first }}
            {{ author.last -}}
          </strong>
        {%- else -%}
          {{ author.first }}
          {{ author.last }}
        {%- endif -%}
        {%- unless forloop.last %}, {% endunless -%}
      {%- endfor -%}
      {%- if entry.author_array.size > 3 %}, et al.{% endif %}
    </p>
    <span class="paper-venue">
      {{- entry.journal -}}
      {%- if entry.volume %}, {{ entry.volume }}{% endif -%}
    </span>
    {% if paper_note and jekyll.environment != 'production' %}
      <span class="fact-placeholder"><b>To confirm</b> {{ paper_note.confirm }}</span>
    {% endif %}
  </div>
  {% if entry.eprint -%}
    <a class="paper-source" href="https://arxiv.org/abs/{{ entry.eprint }}" aria-label="Read {{ entry.title | strip_html | escape }} on arXiv"
      >arXiv <span aria-hidden="true">↗</span></a
    >
  {%- elsif entry.doi -%}
    <a class="paper-source" href="https://doi.org/{{ entry.doi }}">Paper <span aria-hidden="true">↗</span></a>
  {%- endif %}
</article>
