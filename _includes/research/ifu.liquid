    <radialGradient id="ifu-core"><stop stop-color="#fff2df"/><stop offset=".4" stop-color="#f1b896" stop-opacity=".7"/><stop offset="1" stop-color="#d9775f" stop-opacity="0"/></radialGradient>
    <linearGradient id="ifu-legend"><stop stop-color="#7da4c5"/><stop offset=".5" stop-color="#b5b4b0"/><stop offset="1" stop-color="#dd9b89"/></linearGradient>
    <linearGradient id="ifu-disk-gradient"><stop stop-color="#7da4c5" stop-opacity=".7"/><stop offset=".5" stop-color="#b5b4b0" stop-opacity=".35"/><stop offset="1" stop-color="#dd9b89" stop-opacity=".7"/></linearGradient>
