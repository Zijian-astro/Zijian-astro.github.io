{% assign home = site.data.homepage %}
<a class="home-skip" href="#home-content">Skip to content</a>
<div class="observatory-home" id="home-content">
  <section class="home-hero" id="hello" aria-labelledby="home-title">
    <div class="hero-copy">
      <p class="home-eyebrow"><span class="red-point" aria-hidden="true"></span>{{ home.eyebrow }}</p>
      <h1 id="home-title">{{ home.headline }}</h1>
      <p class="hero-lead">{{ home.intro }}</p>
      <div class="hero-bio">{{ content }}</div>
      <div class="home-actions">
        <a class="home-button" href="#research">Explore my research <span aria-hidden="true">↘</span></a>
        <a class="home-text-link" href="{{ '/assets/pdf/CV_ZijianZhang.pdf' | relative_url }}">Curriculum vitae <span aria-hidden="true">↗</span></a>
      </div>
    </div>
    <aside class="hero-portrait" aria-label="About Zijian Zhang">
      <div class="portrait-frame">
        <img
          src="{{ '/assets/img/portrait.jpg' | relative_url }}"
          width="800"
          height="800"
          alt="Portrait of Zijian Zhang on a lake"
          fetchpriority="high"
          loading="eager"
        >
        <span class="portrait-marker" aria-hidden="true"></span>
      </div>
      <div class="portrait-caption">
        <strong
          >Zijian Zhang <span lang="zh-CN">{{ home.name_cn }}</span></strong
        ><span>{{ home.role }}</span>
      </div>
      <div class="portrait-socials" aria-label="Academic profiles">
        <a href="mailto:{{ site.data.socials.email }}">Email <span aria-hidden="true">↗</span></a>
        <a href="https://scholar.google.com/citations?user={{ site.data.socials.scholar_userid }}">Scholar <span aria-hidden="true">↗</span></a>
        <a href="https://orcid.org/{{ site.data.socials.orcid_id }}">ORCID <span aria-hidden="true">↗</span></a>
        <a href="https://github.com/{{ site.data.socials.github_username }}">GitHub <span aria-hidden="true">↗</span></a>
      </div>
    </aside>
  </section>

  <div class="research-index" aria-label="Research themes">
    <span class="index-label">Research notebook</span>
    {% for theme in home.research %}
      <a class="tone-{{ theme.diagram }}" href="#{{ theme.id }}"
        ><span>{{ theme.number }}</span>{{ theme.nav -}}
        <span aria-hidden="true">↘</span></a
      >
    {% endfor %}
    <a class="tone-earlier" href="#{{ home.earlier.id }}"
      ><span aria-hidden="true">··</span>{{ home.earlier.nav -}}
      <span aria-hidden="true">↘</span></a
    >
  </div>

  {% comment %} Unconfirmed facts are shown as dashed notes locally and never in production. {% endcomment %}
  {% assign show_pending = false %}
  {% if jekyll.environment != 'production' %}{% assign show_pending = true %}{% endif %}

  <section id="research" class="home-research" aria-labelledby="research-title">
    <div class="home-section-heading">
      <div>
        <p class="home-eyebrow">Early black holes · from the inside out</p>
        <h2 id="research-title">{{ home.research_heading }}</h2>
      </div>
      <button type="button" class="motion-toggle" hidden aria-pressed="false"><span aria-hidden="true">Ⅱ</span> Pause motion</button>
    </div>
    <p class="research-intro">{{ home.research_intro }}</p>
    {% for theme in home.research %}
      {% if theme.branch %}
        <div class="research-branch">
          <span>{{ theme.branch }}</span><span class="branch-rule" aria-hidden="true"></span>
        </div>
      {% endif %}
      {% if theme.layout == 'wide' %}
        <article
          class="research-story story-wide story-{{ theme.diagram }} tone-{{ theme.diagram }}"
          id="{{ theme.id }}"
          aria-labelledby="title-{{ theme.id }}"
        >
          <div class="research-copy wide-heading">
            <p class="home-eyebrow">
              <span>{{ theme.number }}</span>{{ theme.category }}
            </p>
            <h3 id="title-{{ theme.id }}">{{ theme.title }}</h3>
          </div>
          <div class="research-copy wide-text">
            <p class="research-question">{{ theme.question }}</p>
            <p>{{ theme.description }}</p>
            <p class="research-detail">{{ theme.detail }}</p>
          </div>
          {% include research/figure.liquid theme=theme %}
          <div class="wide-results">
            {% if theme.metrics %}
              <ul class="method-metrics">
                {% for metric in theme.metrics %}
                  <li>
                    <strong>{{ metric.value }}</strong><span>{{ metric.label }}</span>
                  </li>
                {% endfor %}
              </ul>
            {% endif %}
            <div class="method-notes">
              {% if theme.caveat %}
                <p class="method-caveat">{{ theme.caveat }}</p>
              {% endif %}
              {% if theme.contribution.confirmed %}
                <p class="research-contribution">{{ theme.contribution.text }}</p>
              {% elsif theme.contribution and show_pending %}
                <p class="fact-placeholder"><b>To confirm</b> {{ theme.contribution.text }}</p>
              {% endif %}
              {% if theme.links %}
                <ul class="research-paper-links">
                  {% for link in theme.links %}
                    <li>
                      <a href="{{ link.url }}">
                        {{- link.label }}
                        <span aria-hidden="true">↗</span></a
                      >
                    </li>
                  {% endfor %}
                </ul>
              {% endif %}
            </div>
          </div>
        </article>
      {% else %}
        <article class="research-story story-{{ theme.diagram }} tone-{{ theme.diagram }}" id="{{ theme.id }}" aria-labelledby="title-{{ theme.id }}">
          {% include research/figure.liquid theme=theme %}
          <div class="research-copy">
            <p class="home-eyebrow">
              <span>{{ theme.number }}</span>{{ theme.category }}
            </p>
            <h3 id="title-{{ theme.id }}">{{ theme.title }}</h3>
            <p class="research-question">{{ theme.question }}</p>
            <p>{{ theme.description }}</p>
            {% if theme.detail %}
              <p class="research-detail">{{ theme.detail }}</p>
            {% endif %}
            {% if theme.findings %}
              <p class="findings-label" id="findings-{{ theme.id }}">Key results</p>
              <ol class="research-findings" aria-labelledby="findings-{{ theme.id }}">
                {% for finding in theme.findings %}
                  <li>
                    <p class="finding-meta">
                      <strong>{{ finding.year }}</strong><span>{{ finding.venue }}</span>
                    </p>
                    {% if finding.eprint %}
                      {% bibliography --group_by none --template finding-paper --query @*[eprint={{ finding.eprint }}] %}
                    {% endif %}
                    <div>
                      <p class="finding-text">{{ finding.text }}</p>
                      <p class="finding-links">
                        {% for link in finding.links -%}
                          <a href="{{ link.url }}">
                            {{- link.label }}
                            <span aria-hidden="true">↗</span></a
                          >
                        {%- endfor %}
                      </p>
                    </div>
                  </li>
                {% endfor %}
              </ol>
            {% endif %}
            {% if theme.now %}
              <p class="research-now"><span>Now</span>{{ theme.now }}</p>
            {% endif %}
            {% if theme.status %}
              <p class="research-status"><span aria-hidden="true"></span>{{ theme.status }}</p>
            {% endif %}
            {% if theme.links %}
              <ul class="research-paper-links">
                {% for link in theme.links %}
                  <li>
                    <a href="{{ link.url }}">
                      {{- link.label }}
                      <span aria-hidden="true">↗</span></a
                    >
                  </li>
                {% endfor %}
              </ul>
            {% endif %}
          </div>
        </article>
      {% endif %}
    {% endfor %}

    {% assign earlier = home.earlier %}
    <section class="earlier-work tone-earlier" id="{{ earlier.id }}" aria-labelledby="earlier-title">
      <div class="research-branch">
        <span>{{ earlier.branch }}</span><span class="branch-rule" aria-hidden="true"></span>
      </div>
      <div class="earlier-head">
        <h3 id="earlier-title">{{ earlier.title }}</h3>
        <p>{{ earlier.intro }}</p>
      </div>
      <ol class="earlier-grid">
        {% for item in earlier.items %}
          <li>
            <svg class="earlier-glyph" viewBox="0 0 120 32" aria-hidden="true" focusable="false">
              {%- case item.glyph -%}
                {%- when 'recovery' -%}
                  <path d="M6 25h42"/><path d="M48 25 70 9" stroke-dasharray="2 4"/><path d="M70 9h44"/><circle cx="48" cy="25" r="3"/><circle cx="70" cy="9" r="3"/>
                {%- when 'flicker' -%}
                  <path d="M4 20l9-2 6 7 7-17 8 14 7-8 8 10 7-18 9 14 7-4 8 9 9-15 8 9 10-4"/>
                {%- when 'pulses' -%}
                  <path d="M4 26c6 0 7-17 10-17 4 0 7 13 17 16l8 1c6 0 7-15 10-15 4 0 7 12 17 15l8 1c6 0 7-13 10-13 4 0 7 10 17 13h2"/>
              {%- endcase -%}
            </svg>
            <p class="finding-meta">
              <strong>{{ item.year }}</strong><span>{{ item.venue }}</span>
            </p>
            <h4>{{ item.title }}</h4>
            {% if item.eprint %}
              {% bibliography --group_by none --template finding-paper --query @*[eprint={{ item.eprint }}] %}
            {% endif %}
            <p>{{ item.text }}</p>
            <a class="earlier-link" href="{{ item.url }}">Paper <span aria-hidden="true">↗</span></a>
          </li>
        {% endfor %}
      </ol>
    </section>
  </section>

  <section id="first-author-papers" class="home-publications" aria-labelledby="papers-title">
    <div class="home-section-heading">
      <div>
        <p class="home-eyebrow">{{ home.papers.eyebrow }}</p>
        <h2 id="papers-title">{{ home.papers.title }}</h2>
      </div>
      <a class="home-text-link" href="{{ '/publications/' | relative_url }}">All publications <span aria-hidden="true">↗</span></a>
    </div>
    <p class="publication-context">{{ home.papers.intro }}</p>
    {% for group in home.papers.groups %}
      <div class="paper-group">
        <h3 class="paper-group-title">{{ group.title }}</h3>
        {%- capture paper_query -%}
          @*[{% for eprint in group.eprints %}eprint={{ eprint }}{% unless forloop.last %} || {% endunless %}{% endfor %}]
        {%- endcapture %}
        {% bibliography --group_by none --template home-paper --query {{ paper_query }} %}
      </div>
    {% endfor %}
  </section>

  <section id="news" class="home-news" aria-labelledby="news-title">
    <div>
      <p class="home-eyebrow">Along the way</p>
      <h2 id="news-title">Latest <em>updates.</em></h2>
      <a class="home-text-link" href="{{ '/news/' | relative_url }}">All updates <span aria-hidden="true">↗</span></a>
    </div>
    <ol class="home-timeline">
      {% assign latest_news = site.news | sort: 'date' | reverse %}
      {% for item in latest_news limit: 3 %}
        <li>
          <time datetime="{{ item.date | date: '%Y-%m-%d' }}">{{ item.date | date: '%b %Y' }}</time>
          <div>
            {% if item.inline -%}
              {{- item.content | markdownify -}}
            {%- else -%}
              <a href="{{ item.url | relative_url }}">{{ item.title }}</a>
            {%- endif %}
          </div>
        </li>
      {% endfor %}
    </ol>
  </section>

  <section class="home-contact" aria-labelledby="contact-title">
    <span class="red-point" aria-hidden="true"></span>
    <div>
      <p class="home-eyebrow">Contact</p>
      <h2 id="contact-title">Happy to talk about <em>little red dots.</em></h2>
    </div>
    <a href="mailto:{{ site.data.socials.email }}">
      {{- site.data.socials.email }}
      <span aria-hidden="true">↗</span></a
    >
  </section>
</div>
