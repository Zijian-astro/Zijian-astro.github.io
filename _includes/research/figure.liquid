<figure class="research-figure">
  <div class="research-scene" data-scene="{{ include.theme.diagram }}">
    <div class="scene-header">
      <span>Field note / {{ include.theme.number }}</span><span class="scene-kind" title="{{ include.theme.caption | strip | escape }}">Synthetic</span>
    </div>
    {% case include.theme.diagram %}
      {% when 'temporal' -%}
        {%- include research/temporal.liquid %}
      {% when 'population' -%}
        {%- include research/population.liquid %}
      {% when 'slitless' -%}
        {%- include research/slitless.liquid %}
      {% when 'ifu' -%}
        {%- include research/ifu.liquid %}
    {% endcase %}
  </div>
  {% comment %} The full caveat stays available to screen readers and as the tooltip on "Synthetic". {% endcomment %}
  <figcaption class="sr-only">{{ include.theme.caption }}</figcaption>
</figure>
